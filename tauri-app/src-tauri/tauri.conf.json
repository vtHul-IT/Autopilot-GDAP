{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CaptureTech Autopilot GDAP",
  "version": "0.1.6",
  "identifier": "com.capturetech.autopilot-gdap",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CaptureTech Autopilot GDAP",
        "width": 1000,
        "height": 700,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' http://127.0.0.1:1420 ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  }
}
